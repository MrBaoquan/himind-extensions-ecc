{
  "schema_version": "workflow_view.v1",
  "title": "ECC 技能同步",
  "sections": [
    {
      "id": "source",
      "title": "同步仓库",
      "fields": [
        {
          "id": "workspace_root",
          "label": "同步仓库工作区",
          "type": "text",
          "picker": "directory",
          "span": "full",
          "placeholder": "himind-extensions-ecc 仓库根目录",
          "hint": "指向保存技能源的同步仓库；目录里必须有 upstream-policy.json，选错会直接拦下。"
        }
      ]
    },
    {
      "id": "release",
      "title": "发布策略",
      "fields": [
        {
          "id": "dry_run",
          "label": "只预演不发布",
          "type": "boolean",
          "default": false,
          "hint": "打开后只算出要发什么，不建 Release、不改索引。"
        },
        {
          "id": "limit",
          "label": "单次发布上限",
          "type": "number",
          "default": 0,
          "hint": "0 表示不限制；想先小批量试跑就填个位数。"
        },
        {
          "id": "allow_derived",
          "label": "允许发布未校对条目",
          "type": "boolean",
          "default": false,
          "hint": "默认只发 manifests/metadata.json 里标成 reviewed 的技能，其余挂起。"
        }
      ]
    }
  ],
  "actions": ["sync"]
}
