{
  "id": "com.mrbaoquan.ecc-skill-sync",
  "name": "ECC 技能同步",
  "author": "马宝全",
  "categories": ["software-engineering"],
  "description": "把上游 ECC 技能库按 A/B/C 档策略搬进 HiMind，自动生成技能包、跑门禁并发布到市场与 GitHub。",
  "release_notes": "1.1.7：批次发布把还挂在单件 tag 上的旧技能一并接过来，历史逐件 Release 才有机会被回收；限流不再截断技能，避免成员被截断后跟下一次同步撞同名批次 tag。",
  "version": "1.1.7",
  "distribution_targets": ["workbench", "github"],
  "entry": "ecc-skill-sync.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": ["windows-x64"],
  "min_agent_version": "0.3.47",
  "governance": "managed",
  "capabilities": [
    {
      "id": "ecc.sync.probe",
      "description": "对比上游 HEAD 与本地锁文件，判断要不要同步",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
        },
        "additionalProperties": false
      },
      "risk_level": "read_only",
      "availability": "local",
      "timeout_seconds": 600
    },
    {
      "id": "ecc.sync.fetch",
      "description": "把上游指定提交的源码树拉到本地缓存",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "commit": {"type": "string"},
          "repo_url": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}
        },
        "additionalProperties": false
      },
      "risk_level": "local_write",
      "availability": "local",
      "timeout_seconds": 1800
    },
    {
      "id": "ecc.sync.generate",
      "description": "按策略生成技能包、清单、索引与本次同步报告",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "source_root": {"type": "string"},
          "tool": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}
        },
        "additionalProperties": false
      },
      "risk_level": "local_write",
      "availability": "local",
      "timeout_seconds": 1800
    },
    {
      "id": "ecc.sync.gate",
      "description": "跑构建、单元测试与扩展仓库契约三道门禁",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        },
        "additionalProperties": false
      },
      "risk_level": "local_action",
      "availability": "local",
      "timeout_seconds": 3600
    },
    {
      "id": "ecc.sync.publish",
      "description": "把新版本发到 GitHub Release 并增补市场索引",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "dry_run": {"type": "boolean"},
          "limit": {"type": "integer"},
          "allow_derived": {"type": "boolean"},
          "repository": {"type": "string"},
          "channel": {"type": "string"},
          "private_key_path": {"type": "string"},
          "key_id": {"type": "string"},
          "dist_dir": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        },
        "additionalProperties": false
      },
      "risk_level": "network_write",
      "availability": "local",
      "timeout_seconds": 3600
    },
    {
      "id": "ecc.sync.review_queue",
      "description": "报出还欠人工校对的技能条数与明细",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "source_root": {"type": "string"},
          "status": {"type": "string", "enum": ["derived", "stale"]},
          "category": {"type": "string"},
          "limit": {"type": "integer", "minimum": 0, "maximum": 500},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
        },
        "additionalProperties": false
      },
      "risk_level": "read_only",
      "availability": "local",
      "timeout_seconds": 600
    },
    {
      "id": "ecc.sync.distribution",
      "description": "报出每条技能此刻的分发状态，以及分类与模块的排除概览",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "state": {"type": "string", "enum": ["distributed", "pending", "held", "excluded"]},
          "category": {"type": "string"},
          "module": {"type": "string"},
          "keyword": {"type": "string"},
          "limit": {"type": "integer", "minimum": 0, "maximum": 500},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
        },
        "additionalProperties": false
      },
      "risk_level": "read_only",
      "availability": "local",
      "timeout_seconds": 600
    },
    {
      "id": "ecc.sync.dispatch_policy_save",
      "description": "整份写回分发策略：哪些分类、模块或单条技能不参与分发",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "excluded_modules": {"type": "object"},
          "excluded_categories": {"type": "object"},
          "excluded_skills": {"type": "object"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
        },
        "additionalProperties": false
      },
      "risk_level": "local_write",
      "availability": "local",
      "timeout_seconds": 600
    },
    {
      "id": "ecc.sync.repo_hint",
      "description": "推断本机的 ECC 仓库根目录，并校验调用方手里那一个还能不能用",
      "input_schema": {
        "type": "object",
        "properties": {
          "repo_root": {"type": "string"},
          "workspace_root": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
        },
        "additionalProperties": false
      },
      "risk_level": "read_only",
      "availability": "local",
      "timeout_seconds": 600
    }
  ],
  "permissions": [
    "filesystem.workspace.read",
    "filesystem.workspace.write",
    "process.go",
    "process.git",
    "process.gh",
    "network.github.write"
  ],
  "contributes": {
    "views": [
      {
        "id": "ecc-skill-sync.dispatch",
        "title": "ECC 分发管理",
        "short_title": "分发管理",
        "icon": "package",
        "quick_access": true,
        "order": 60,
        "location": "plugin_navigation",
        "entry": "ui/index.html"
      }
    ],
    "commands": [
      {"id": "ecc.sync.probe", "title": "探测上游 ECC 变更"},
      {"id": "ecc.sync.fetch", "title": "拉取上游 ECC 源码"},
      {"id": "ecc.sync.generate", "title": "生成 ECC 技能包与索引"},
      {"id": "ecc.sync.gate", "title": "运行 ECC 同步门禁"},
      {"id": "ecc.sync.publish", "title": "发布 ECC 扩展到市场"},
      {"id": "ecc.sync.review_queue", "title": "查看 ECC 待校对技能"},
      {"id": "ecc.sync.distribution", "title": "查看 ECC 分发状态"},
      {"id": "ecc.sync.dispatch_policy_save", "title": "保存 ECC 分发策略"},
      {"id": "ecc.sync.repo_hint", "title": "推断 ECC 仓库目录"}
    ]
  }
}
